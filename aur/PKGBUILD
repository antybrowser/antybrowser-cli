# Maintainer: Antybrowser <support@antybrowser.com>
pkgname=antybrowser-cli
pkgver=1.0.0
pkgrel=1
pkgdesc="CLI tool for managing Antybrowser profiles, proxies, and automations"
arch=('x86_64' 'aarch64')
url="https://antybrowser.com"
license=('MIT')
depends=()
makedepends=('go')
provides=('antybrowser-cli')
conflicts=('antybrowser-cli-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/antybrowser/antybrowser-cli/archive/refs/tags/cli-v$pkgver.tar.gz")
sha256sums=('PLACEHOLDER_SHA256')

build() {
  cd "$pkgname-$pkgver"
  go build -trimpath -ldflags="-s -w" -o antybrowser ./cmd/antybrowser
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 antybrowser "$pkgdir/usr/bin/antybrowser"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
