<component type="desktop-application">
  <id>io.antybrowser.Desktop</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Antybrowser</name>
  <summary>Anti-detect browser for multi-account management</summary>
  <description>
    <p>
      Antybrowser is an anti-detect browser that lets you manage multiple browser profiles
      with unique fingerprints, proxy settings, and isolated browser states.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Profile management with unique fingerprints</li>
      <li>Proxy chain support (HTTP, SOCKS4, SOCKS5)</li>
      <li>Extension management</li>
      <li>Cookie import/export</li>
      <li>Team collaboration</li>
      <li>S3 sync for profile backup</li>
    </ul>
  </description>
  <url type="homepage">https://antybrowser.com</url>
  <url type="bugtracker">https://antybrowser.com/support</url>
  <developer id="com.antybrowser">
    <name>Antybrowser.com</name>
  </developer>
